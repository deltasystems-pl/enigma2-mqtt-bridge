#: src/MQTTBridge/webif.py
msgid "Menu settings and the menu creator"
msgstr "Ustawienia menu i kreator menu"

#: src/MQTTBridge/webif.py
msgid "Menu creator"
msgstr "Kreator menu"

#: src/MQTTBridge/webif.py
msgid "Menu settings"
msgstr "Ustawienia menu"

#: src/MQTTBridge/webif.py
msgid "Back to MQTT Bridge"
msgstr "Wróć do MQTT Bridge"

#: src/MQTTBridge/webif.py
msgid "%d h"
msgstr "%d godz."

#: src/MQTTBridge/webif.py
msgid "Your unsaved changes will be lost."
msgstr "Niezapisane zmiany zostaną utracone."

#: src/MQTTBridge/webif.py
msgid "Saved; Home Assistant's copy has not arrived yet."
msgstr "Zapisano; kopia z Home Assistant jeszcze nie dotarła."

#: src/MQTTBridge/webif.py
msgid "Home Assistant refused the save: the menu was changed elsewhere since this page loaded it. Reload to see it - your changes here stay on the page until you do."
msgstr "Home Assistant odrzucił zapis: menu zmieniono gdzie indziej od chwili wczytania tej strony. Wczytaj je ponownie, by je zobaczyć - Twoje zmiany zostają na stronie do tego czasu."

#: src/MQTTBridge/webif.py
msgid "The receiver is already waiting for Home Assistant to answer other saves. Try again in a moment."
msgstr "Odbiornik czeka już na odpowiedź Home Assistant na inne zapisy. Spróbuj za chwilę."

#: src/MQTTBridge/webif.py
msgid "The receiver got no answer from Home Assistant within ten seconds. The menu may still have been saved: reload to see."
msgstr "Odbiornik nie dostał odpowiedzi od Home Assistant w ciągu dziesięciu sekund. Menu mogło mimo to zostać zapisane: wczytaj ponownie, by sprawdzić."

#: src/MQTTBridge/webif.py
msgid "The receiver refused the menu: it is too large to send."
msgstr "Odbiornik odrzucił menu: jest za duże, by je wysłać."

#: src/MQTTBridge/webif.py
msgid "The receiver refused the request. Reload the page."
msgstr "Odbiornik odrzucił żądanie. Odśwież stronę."

#: src/MQTTBridge/webif.py
msgid "The receiver refused the save: this page is out of date - it was changed in another tab or window since it was opened. Reload the page and try again."
msgstr "Odbiornik odrzucił zapis: ta strona jest nieaktualna - zmieniono ją w innej karcie lub oknie od chwili otwarcia. Odśwież stronę i spróbuj ponownie."

#: src/MQTTBridge/webif.py
msgid "The receiver could not complete the save; see the plugin log."
msgstr "Odbiornik nie mógł dokończyć zapisu; zobacz dziennik wtyczki."

#: src/MQTTBridge/webif.py
msgid "%d s"
msgstr "%d s"

#: src/MQTTBridge/webif.py
msgid "%d min"
msgstr "%d min"

#: src/MQTTBridge/webif.py
msgid "editing from the receiver is switched off in Home Assistant"
msgstr "edycja z odbiornika jest wyłączona w Home Assistant"

#: src/MQTTBridge/webif.py
msgid "Editing the menu from the receiver is switched off in Home Assistant: the companion integration's options, under the receiver menu, can switch it on."
msgstr "Edycja menu z odbiornika jest wyłączona w Home Assistant: można ją włączyć w opcjach integracji, w części menu odbiornika."

#: src/MQTTBridge/webif.py
msgid "Home Assistant refused the save: editing the menu from the receiver is switched off in its integration options."
msgstr "Home Assistant odrzucił zapis: edycja menu z odbiornika jest wyłączona w opcjach integracji."

#: src/MQTTBridge/choicelist.py
msgid "From Home Assistant, via MQTT Bridge"
msgstr "Od Home Assistant, przez MQTT Bridge"

#: src/MQTTBridge/choicelist.py
msgid "Closes in %d s"
msgstr "Zamknie się za %d s"

#: src/MQTTBridge/choicelist.py
msgid "OK or the row's key choose   EXIT dismiss"
msgstr "OK lub klawisz wiersza wybierz   EXIT zamknij"

#: src/MQTTBridge/choicelist.py
msgid "OK choose   EXIT dismiss"
msgstr "OK wybierz   EXIT zamknij"

#: src/MQTTBridge/choicelist.py
msgid "%(label)s in %(seconds)d s"
msgstr "%(label)s za %(seconds)d s"

#: src/MQTTBridge/setup.py
msgid "Allow deleting recordings (into the trash)"
msgstr "Zezwalaj na usuwanie nagrań (do kosza)"

#: src/MQTTBridge/setup.py
msgid "Recordings"
msgstr "Nagrania"

#: src/MQTTBridge/webif.py
msgid "Play a recording"
msgstr "Odtwórz nagranie"

#: src/MQTTBridge/webif.py
msgid "Recording id"
msgstr "Identyfikator nagrania"

#: src/MQTTBridge/webif.py
msgid "Move a recording to the trash"
msgstr "Przenieś nagranie do kosza"

#: src/MQTTBridge/webif.py
msgid "The recording is moved to the receiver's trash, where the receiver's own trash settings decide when it is emptied."
msgstr "Nagranie trafia do kosza dekodera; kiedy kosz zostanie opróżniony, decydują ustawienia kosza w dekoderze."

#: src/MQTTBridge/webif.py
msgid "Read the recording library again"
msgstr "Wczytaj ponownie listę nagrań"

#: src/MQTTBridge/config.py
msgid "PREVIOUS (Back on many TV remotes)"
msgstr "PREVIOUS (Wstecz na wielu pilotach TV)"

#: src/MQTTBridge/config.py
msgid "PLAY/PAUSE"
msgstr "PLAY/PAUSE"

#: src/MQTTBridge/setup.py
msgid "Key pressed several times to open the menu"
msgstr "Klawisz naciskany kilka razy, by otworzyć menu"

#: src/MQTTBridge/setup.py
msgid "Presses that open the menu"
msgstr "Liczba naciśnięć otwierająca menu"

#: src/MQTTBridge/setup.py
msgid "Longest pause between two presses"
msgstr "Najdłuższa przerwa między naciśnięciami"

#: src/MQTTBridge/webif.py
msgid "Or %s pressed %s times, at most %s apart."
msgstr "Albo %s naciśnięty %s razy, w odstępach do %s."

#: src/MQTTBridge/webif.py
msgid "While a key is chosen for the press combo, that key does nothing else in live TV; PREVIOUS also in the players."
msgstr "Gdy dla kombinacji naciśnięć wybrano klawisz, ten klawisz w telewizji na żywo nie robi nic innego; PREVIOUS również w odtwarzaczach."
