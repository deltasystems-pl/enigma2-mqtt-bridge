msgstr "Ta strona jest nieaktualna: od jej otwarcia coś zmieniono w innej karcie lub oknie. Odśwież stronę i spróbuj ponownie."

#: src/MQTTBridge/webif.py
msgid "Full size"
msgstr "Pełny rozmiar"


#: src/MQTTBridge/webif.py
msgid "Open in a new tab"
msgstr "Otwórz w nowej karcie"

#: src/MQTTBridge/webif.py
msgid "Screenshot from %s"
msgstr "Zrzut z %s"

#: src/MQTTBridge/webif.py
msgid "Screenshots are not available right now."
msgstr "Zrzuty ekranu są teraz niedostępne."

#: src/MQTTBridge/webif.py
msgid "Screenshots are switched off in the settings."
msgstr "Zrzuty ekranu są wyłączone w ustawieniach."

#: src/MQTTBridge/webif.py
msgid "Taking a screenshot; this page will refresh by itself."
msgstr "Trwa robienie zrzutu ekranu; strona odświeży się sama."

#: src/MQTTBridge/webif.py
msgid "No screenshot to show yet."
msgstr "Nie ma jeszcze zrzutu ekranu do pokazania."

#: src/MQTTBridge/setup.py
msgid "Allow starting an EPG import"
msgstr "Zezwalaj na import EPG na żądanie"

#: src/MQTTBridge/webif.py
msgid "Import the EPG now"
msgstr "Pobierz EPG teraz"

#: src/MQTTBridge/webif.py
msgid "EPG-Importer downloads the guide now. When it finishes, the menus freeze for two or three seconds while the guide is saved."
msgstr "EPG-Importer pobiera teraz przewodnik. Na koniec menu zatrzymują się na dwie, trzy sekundy, gdy przewodnik jest zapisywany."

#: src/MQTTBridge/setup.py
msgid "Allow removing the plugin remotely"
msgstr "Zezwalaj na zdalne usunięcie wtyczki"

#: src/MQTTBridge/setup.py
msgid "Check daily for plugin updates"
msgstr "Codziennie sprawdzaj aktualizacje wtyczki"

#: src/MQTTBridge/setup.py
msgid "Allow plugin updates over MQTT"
msgstr "Zezwalaj na aktualizacje wtyczki przez MQTT"

#: src/MQTTBridge/selfupdate.py
msgid "An update of the plugin is being applied on this receiver. Please wait."
msgstr "Na tym dekoderze trwa aktualizacja wtyczki. Proszę czekać."

#: src/MQTTBridge/selfupdate.py
msgid "The update of the plugin failed and its previous version could not be put back. Please install the plugin again, for example from Home Assistant."
msgstr "Aktualizacja wtyczki nie powiodła się i nie udało się przywrócić jej poprzedniej wersji. Zainstaluj wtyczkę ponownie, na przykład z Home Assistant."

#: src/MQTTBridge/selfupdate.py
msgid "The update of the plugin did not finish cleanly. Please install the plugin again, for example from Home Assistant."
msgstr "Aktualizacja wtyczki nie zakończyła się poprawnie. Zainstaluj wtyczkę ponownie, na przykład z Home Assistant."

#: src/MQTTBridge/webif.py
msgid "Check for plugin updates now"
msgstr "Sprawdź teraz aktualizacje wtyczki"

#: src/MQTTBridge/webif.py
msgid "Remove the plugin from this receiver"
msgstr "Usuń wtyczkę z tego dekodera"

#: src/MQTTBridge/webif.py
msgid "The plugin is removed from this receiver and the user interface restarts. There is no way back from here or from Home Assistant: only the receiver's own plugin menu or SSH can install it again. Its settings stay on the receiver."
msgstr "Wtyczka zostanie usunięta z tego dekodera, a interfejs uruchomi się ponownie. Nie da się tego cofnąć stąd ani z Home Assistant: zainstalować ją z powrotem można tylko z menu wtyczek dekodera albo przez SSH. Jej ustawienia zostają w dekoderze."

#: src/MQTTBridge/setup.py
msgid "Settings saved. The plugin is being removed from this receiver, so they are not applied now; they take effect if the removal stops or the plugin is installed again."
msgstr "Ustawienia zapisane. Wtyczka jest właśnie usuwana z tego dekodera, więc nie zostaną teraz zastosowane; zaczną działać, jeśli usuwanie się przerwie albo wtyczka zostanie zainstalowana ponownie."

#: src/MQTTBridge/webif.py
msgid "Zap to a recently watched channel"
msgstr "Przełącz na kanał z ostatnio oglądanych"

#: src/MQTTBridge/webif.py
msgid "Clear the recently watched list"
msgstr "Wyczyść ostatnio oglądane"

#: src/MQTTBridge/webif.py
msgid "The receiver switches to channel 1, the first channel of its first bouquet, and empties its list of recently watched channels."
msgstr "Dekoder przełączy się na kanał 1, pierwszy kanał pierwszego bukietu, i wyczyści listę ostatnio oglądanych kanałów."

#: src/MQTTBridge/setup.py
msgid "Plugin updates"
msgstr "Aktualizacje wtyczki"

#: src/MQTTBridge/updatescreen.py
msgid "Close"
msgstr "Zamknij"

#: src/MQTTBridge/updatescreen.py
msgid "Install"
msgstr "Zainstaluj"

#: src/MQTTBridge/updatescreen.py
msgid "Check now"
msgstr "Sprawdź teraz"

#: src/MQTTBridge/updatescreen.py
msgid "Asked for the list of versions; it is shown here as soon as it arrives."
msgstr "Wysłano prośbę o listę wersji; pojawi się tutaj, gdy tylko dotrze."

#: src/MQTTBridge/updatescreen.py
msgid "The update to version %s has started."
msgstr "Rozpoczęto aktualizację do wersji %s."

#: src/MQTTBridge/updateview.py
msgid "%s - newer version"
msgstr "%s - nowsza wersja"

#: src/MQTTBridge/updateview.py
msgid "Update to %(target)s, started %(who)s: %(phase)s"
msgstr "Aktualizacja do %(target)s, uruchomiona %(who)s: %(phase)s"

#: src/MQTTBridge/updateview.py
msgid "This copy of the plugin was not installed by the package manager, so it cannot update itself."
msgstr "Ta kopia wtyczki nie została zainstalowana przez menedżer pakietów, więc nie może sama się zaktualizować."

#: src/MQTTBridge/updateview.py
msgid "An installation or update of the plugin is already running on the receiver."
msgstr "Na dekoderze trwa już instalacja lub aktualizacja wtyczki."

#: src/MQTTBridge/updateview.py
msgid "The receiver's package manager is busy. Try again in a moment."
msgstr "Menedżer pakietów dekodera jest zajęty. Spróbuj ponownie za chwilę."

#: src/MQTTBridge/updateview.py
msgid "The receiver is in standby. An update restarts the receiver's user interface, which wakes it and may switch the television on. Switch the receiver on and try again."
msgstr "Dekoder jest w trybie czuwania. Aktualizacja uruchamia ponownie interfejs dekodera, co go wybudzi i może włączyć telewizor. Włącz dekoder i spróbuj ponownie."

#: src/MQTTBridge/updateview.py
msgid "The receiver is recording or is about to start a recording. Try again when the recording has finished."
msgstr "Dekoder nagrywa albo za chwilę zacznie nagrywać. Spróbuj ponownie po zakończeniu nagrania."

#: src/MQTTBridge/updateview.py
msgid "An EPG import is running. Try again when it has finished."
msgstr "Trwa import EPG. Spróbuj ponownie po jego zakończeniu."

#: src/MQTTBridge/updateview.py
msgid "The receiver cannot restart its user interface right now. Try again in a moment."
msgstr "Dekoder nie może teraz ponownie uruchomić interfejsu. Spróbuj ponownie za chwilę."

#: src/MQTTBridge/updateview.py
msgid "There is not enough free space on the receiver."
msgstr "Na dekoderze brakuje wolnego miejsca."

#: src/MQTTBridge/updateview.py
msgid "An update ran less than ten minutes ago. Try again later."
msgstr "Aktualizacja odbyła się mniej niż dziesięć minut temu. Spróbuj ponownie później."

#: src/MQTTBridge/updateview.py
msgid "The update could not be started; the plugin log says why."
msgstr "Nie udało się rozpocząć aktualizacji; przyczyna jest w dzienniku wtyczki."

#: src/MQTTBridge/updateview.py
msgid "%(version)s - cannot be installed: %(reason)s"
msgstr "%(version)s - nie można zainstalować: %(reason)s"

#: src/MQTTBridge/updateview.py
msgid "%s - installed"
msgstr "%s - zainstalowana"

#: src/MQTTBridge/updateview.py
msgid "%s - older version"
msgstr "%s - starsza wersja"

#: src/MQTTBridge/updateview.py
msgid "Installed version: %s"
msgstr "Zainstalowana wersja: %s"

#: src/MQTTBridge/updateview.py
msgid "from Home Assistant"
msgstr "z Home Assistant"

#: src/MQTTBridge/updateview.py
msgid "from the internet"
msgstr "z internetu"

#: src/MQTTBridge/updateview.py
msgid "No list of versions is known yet. Check for updates first."
msgstr "Lista wersji nie jest jeszcze znana. Najpierw sprawdź aktualizacje."

#: src/MQTTBridge/updateview.py
msgid "The last check could not reach the list of versions on the internet."
msgstr "Ostatnie sprawdzenie nie dotarło do listy wersji w internecie."

#: src/MQTTBridge/updateview.py
msgid "Last update to %(target)s, started %(who)s: %(result)s"
msgstr "Ostatnia aktualizacja do %(target)s, uruchomiona %(who)s: %(result)s"

#: src/MQTTBridge/updateview.py
msgid "Version %s is not on the plugin's signed list of versions. Check for updates and try again."
msgstr "Wersji %s nie ma na podpisanej liście wersji wtyczki. Sprawdź aktualizacje i spróbuj ponownie."

#: src/MQTTBridge/updateview.py
msgid "Version %s has been withdrawn by the plugin's authors."
msgstr "Wersja %s została wycofana przez autorów wtyczki."

#: src/MQTTBridge/updateview.py
msgid "Version %s is older than the oldest version this plugin can install."
msgstr "Wersja %s jest starsza niż najstarsza wersja, którą ta wtyczka może zainstalować."

#: src/MQTTBridge/updateview.py
msgid "Version %s does not work with this plugin or with the Home Assistant integration."
msgstr "Wersja %s nie współpracuje z tą wtyczką albo z integracją Home Assistant."

#: src/MQTTBridge/updateview.py
msgid "Version %s needs a package that is not installed on this receiver."
msgstr "Wersja %s wymaga pakietu, którego nie ma na tym dekoderze."

