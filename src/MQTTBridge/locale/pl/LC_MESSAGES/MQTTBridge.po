msgid "Version %s is already installed and running."
msgstr "Wersja %s jest już zainstalowana i działa."

#: src/MQTTBridge/updateview.py
msgid "downloading"
msgstr "pobieranie"

#: src/MQTTBridge/updateview.py
msgid "checking the download"
msgstr "sprawdzanie pobranego pliku"

#: src/MQTTBridge/updateview.py
msgid "saving the current version"
msgstr "zapisywanie obecnej wersji"

#: src/MQTTBridge/updateview.py
msgid "installing"
msgstr "instalowanie"

#: src/MQTTBridge/updateview.py
msgid "restarting the user interface"
msgstr "ponowne uruchamianie interfejsu"

#: src/MQTTBridge/updateview.py
msgid "checking the new version"
msgstr "sprawdzanie nowej wersji"

#: src/MQTTBridge/updateview.py
