#!/bin/sh
# Removing this package has to remove the plugin, and until now it did not.
#
# The image byte-compiles a plugin after opkg has installed it, so the `.pyc`
# files in the plugin directory were written by the receiver and are not in
# opkg's file list. `opkg remove` deletes the files it installed — the `.py`
# ones — and walks away from the compiled copies. On an OpenViX 6.6 receiver
# that left forty files behind: the whole plugin, still compiled, in the legacy
# same-directory form that Python 3 imports on its own without a `.py` beside
# it. enigma2's plugin loader enumerates by module name, so the next GUI restart
# loaded the plugin that had just been removed, and it reconnected to the broker
# while `opkg status` said nothing was installed.
#
# The set of `.pyc` files is not the set of `.py` files of any one build —
# `setup.pyc` was there because somebody had opened the setup screen once — so
# this sweeps by pattern under the plugin directory and never from a list.
#
# What it deletes is bytecode, and only bytecode. The `.py` files are opkg's and
# are all still on disk while this runs; a `.mo`, a capture, anything somebody
# put there themselves is left where it is. Settings live in
# /etc/enigma2/settings and are not touched at all, so a reinstall finds its
# configuration.
#
# `postinst` refuses a plugin directory with no `plugin.py` in it, because there
# „every `.pyc` whose `.py` is missing" would be a whole plugin whose sources OE
# had stripped into a separate package at build time. Here that refusal would be
# backwards: a removal is exactly the moment such a tree should go. In an image
# built that way the bytecode is in opkg's own file list, so the worst this can
# do is get there first and leave opkg reporting a file that is already gone,
# which cannot fail a removal.
#
# What it promises, and what tests/test_prerm_sweep.py holds it to:
#
#   * on a removal, every `.pyc` and `.pyo` under the plugin directory goes, and
#     so does every directory that is empty afterwards, the plugin directory
#     included;
#   * a `.py` — or anything else that is not bytecode — is never deleted, and
#     keeps its directory and every directory above it;
#   * on the removal half of an upgrade nothing is swept at all;
#   * nothing outside the resolved plugin directory is read, deleted or
#     rmdir'd, no symlink is followed or removed, and a different filesystem
#     mounted under the plugin directory is not walked into;
#   * bytecode under a directory whose name contains a **newline** is skipped
#     rather than deleted. `find` prints such a path as two lines and neither
#     half is something this may touch, which is deliberate: a directory with a
#     newline in its name cannot be a Python package, so nothing importable is
#     left behind by skipping it;
#   * nothing happens at all during an offline rootfs build;
#   * no error here can fail an `opkg remove`.

# A rootfs being assembled is not a receiver. OE's do_rootfs runs maintainer
# scripts on the build host with `D` or `OPKG_OFFLINE_ROOT` pointing at the
# image directory, and every path below is absolute — so the sweep would walk
# the *build host's* filesystem.
[ -z "${D:-}${OPKG_OFFLINE_ROOT:-}" ] || exit 0

# opkg runs this script at two different moments and says which one it is:
# `prerm remove` before a removal, and `prerm upgrade` on the removal half of an
# upgrade — the old package's script, run before the new package's files are
# unpacked. Only the removal is swept.
#
# The upgrade case is already covered, and covered better, by `postinst`: it
# sweeps after the new tree is unpacked, which is the only moment at which
# „this bytecode has no source" is a true statement. Sweeping here as well would
# delete every compiled file the receiver has, including the ones the new
# package is about to reuse, and buy nothing but a slower first start while
# enigma2 recompiles the lot. An argument this script does not recognise —
# `failed-upgrade`, or whatever a future opkg invents — is treated as an
# upgrade, because that is the half of the guess that leaves files alone. No
# argument at all is treated as a removal: a `./prerm` run by hand is somebody
# taking this off their box.
case "${1:-remove}" in
    remove) ;;
    *) exit 0 ;;
esac

PLUGIN_DIR=/usr/lib/enigma2/python/Plugins/Extensions/MQTTBridge

# `MQTTBRIDGE_PLUGIN_DIR` is the test suite's seam, and opkg passes its
# environment to maintainer scripts verbatim — so it is reachable in production
# whether or not that was anybody's intention. It is therefore honoured only
# alongside a second variable that exists for no other purpose, and the guards
# below (the basename, the symlink test, and every path being checked to be
# under the resolved root) apply to it exactly as they do to the real path.
# `postinst` has the same seam under its own name.
if [ "${MQTTBRIDGE_PRERM_TEST:-}" = "1" ] && [ -n "${MQTTBRIDGE_PLUGIN_DIR:-}" ]; then
    PLUGIN_DIR=$MQTTBRIDGE_PLUGIN_DIR
fi

# A trailing slash would defeat every `case` below, which compares against
# `"$dir"/*`.
while :; do
    case "$PLUGIN_DIR" in
        */) PLUGIN_DIR=${PLUGIN_DIR%/} ;;
        *) break ;;
    esac
done

# „1 compiled file" / „3 compiled files". A package script's output is read by
# a person, and a person reads „1 files" as a bug in whatever printed it.
count_phrase() {
    if [ "$1" -eq 1 ]; then
        printf '%s %s' "$1" "$2"
    else
        printf '%s %s' "$1" "$3"
    fi
}

# Delete one compiled file, if that is what it is, and say so. Used for the
# OpenWebif hook, which is addressed by name rather than swept.
remove_compiled() {
    [ -f "$1" ] || return 0
    # `-f` is true for a symlink to a regular file. A link is not ours to
    # follow and not ours to delete.
    [ -L "$1" ] && return 0
    rm -f "$1" 2>/dev/null &&
        printf '%s\n' "MQTT Bridge: removed the compiled OpenWebif hook ${1##*/}"
}

sweep_plugin_directory() {
    dir=$1

    # The only directory this may ever sweep is the plugin's own, whatever an
    # environment variable says.
    case "$dir" in
        */MQTTBridge) ;;
        *) return 0 ;;
    esac

    # 🔴 A symlinked plugin directory is refused outright, and this is where
    # this script parts company with `postinst`. That sweep only ever deletes
    # files, so resolving a link and sweeping what it points at is safe. This
    # one removes the directories as well, and the last of them is the plugin
    # directory itself — so following the link would empty and remove a
    # directory somebody deliberately put somewhere else (onto a USB stick, off
    # a full flash) and leave the link dangling behind it. Refusing costs the
    # owner of such a box one `rm -rf`; guessing costs them whatever else was in
    # there.
    #
    # It is refused out loud. The documentation promises that removing the
    # package takes the compiled plugin with it, and on this one arrangement it
    # does not — so the person removing it is told, and told where to look,
    # rather than left with a promise that quietly did not hold.
    if [ -L "$dir" ]; then
        target=$(cd -P "$dir" 2>/dev/null && pwd -P)
        [ -n "$target" ] || target=$(readlink "$dir" 2>/dev/null)
        [ -n "$target" ] || target="a link this receiver cannot follow"
        printf '%s\n' "MQTT Bridge: $dir is a symlink to $target, so its compiled files were left in place; removing a directory somebody linked elsewhere is not this package's to do."
        return 0
    fi
    [ -d "$dir" ] || return 0

    # Resolved for the paths below, because a symlinked *parent* is ordinary on
    # a receiver whose flash is short. The basename is not re-checked
    # afterwards: the last component is not a symlink — that was just refused —
    # so resolving the ones above it cannot change what this directory is
    # called.
    dir=$(cd -P "$dir" 2>/dev/null && pwd -P) || return 0
    [ -n "$dir" ] || return 0
    [ -d "$dir" ] || return 0

    # `-xdev` so a *different filesystem* mounted under the plugin directory —
    # a USB stick, a network share — is not walked into. It is the device
    # number that is compared, so a same-filesystem `mount --bind` is descended
    # like any other directory and this is not a guard against one. Probed
    # rather than assumed: busybox builds it optionally, and a busybox without
    # it must lose the hardening rather than lose the sweep. Checked at
    # `-maxdepth 0`, so the probe does not walk the tree.
    XDEV=-xdev
    find "$dir" -xdev -maxdepth 0 >/dev/null 2>&1 || XDEV=

    # `-depth` is probed the same way and for the same reason. It is POSIX, and
    # every `find` a receiver is likely to have supports it — but the directory
    # pass is the half of this script that cannot be written safely without it
    # (a listing sorted by depth would have to survive a newline in a directory
    # name), so a `find` that refuses it loses the directory pass rather than
    # getting a sorting trick nobody can review. Both probes go through
    # `-maxdepth`, so a `find` without *that* loses both; that is a degradation
    # and not a failure, because opkg removes its own directories afterwards.
    DEPTH=-depth
    find "$dir" -depth -maxdepth 0 >/dev/null 2>&1 || DEPTH=

    # `-type f` and no `-L`: a symlink inside the tree is neither followed nor
    # removed, so a link out of the plugin directory cannot become a way out.
    # $XDEV is deliberately unquoted — it is one fixed word or nothing.
    #
    # The counting is done inside the pipeline and comes back as its output,
    # one `x` per file: the right-hand side of a pipe is a subshell in every
    # shell a receiver has, so a variable incremented in there is gone by the
    # time anybody could read it.
    removed=$(
        find "$dir" $XDEV \( -name '*.pyc' -o -name '*.pyo' \) -type f -print 2>/dev/null |
        while IFS= read -r bytecode; do
            # 🔴 `read` splits on newlines and a filename may contain one, so a
            # directory called `evil<newline>etc` arrives here as two lines and
            # the second of them — `etc/passwd.pyc` — is a *relative* path.
            # opkg never chdir()s, so for a GUI-driven removal that would
            # resolve against `/`. Nothing is touched unless it is under the
            # plugin directory.
            case "$bytecode" in
                "$dir"/*) ;;
                *) continue ;;
            esac
            [ -f "$bytecode" ] || continue
            [ -L "$bytecode" ] && continue
            rm -f "$bytecode" 2>/dev/null && printf 'x'
        done
    )
    if [ -n "$removed" ]; then
        phrase=$(count_phrase ${#removed} 'compiled file' 'compiled files')
        printf '%s\n' "MQTT Bridge: removed $phrase from the plugin directory."
    fi

    # Deepest first, so a directory is offered to `rmdir` only once everything
    # under it has been. `rmdir` refuses a directory with anything in it, and
    # that refusal is what makes „every directory that is now empty" safe to
    # say: a `.py` opkg has not deleted yet, a `.mo`, a `__pycache__` somebody
    # else writes into — each keeps its own directory and every directory above
    # it, without this script having to decide what any of them are.
    #
    # Unlike `postinst`, this gives back directories it did not empty itself.
    # That is the difference between an upgrade and a removal: during an upgrade
    # an empty `screenshots/` is a directory the plugin means to keep, and here
    # the plugin is going away. The plugin directory is the last path `-depth`
    # prints, so it is the last one removed.
    if [ -n "$DEPTH" ]; then
        find "$dir" $DEPTH $XDEV -type d -print 2>/dev/null |
        while IFS= read -r holder; do
            # The same split, aimed at the directory removal rather than at a
            # file.
            case "$holder" in
                "$dir"|"$dir"/*) ;;
                *) continue ;;
            esac
            rmdir "$holder" 2>/dev/null
        done
    elif [ -d "$dir" ]; then
        printf '%s\n' "MQTT Bridge: this receiver's find has no -depth, so the empty directories under $dir were left for opkg."
    fi

    [ -d "$dir" ] || return 0

    # Something is left. Whether that is worth saying depends on whether
    # anything else is coming: during an ordinary removal every `.py` is still
    # here, because opkg deletes them after this script returns, so a count
    # taken now would be a number about files that are about to go — printed on
    # every single removal. The count is reported only once no source remains,
    # which is the state in which nothing else is coming.
    #
    # It says what it knows and not why. A leftover is usually somebody's own
    # file, but it is also what a `.pyc` on a read-only filesystem, or one whose
    # `rm` was refused, looks like from here — and „not this package's" would be
    # the wrong thing to tell the second person.
    sources=$(
        find "$dir" $XDEV -name '*.py' -type f -print 2>/dev/null |
        while IFS= read -r _source; do printf 'x'; done
    )
    [ -z "$sources" ] || return 0

    leftovers=$(
        find "$dir" $XDEV ! -type d -print 2>/dev/null |
        while IFS= read -r _leftover; do printf 'x'; done
    )
    if [ -n "$leftovers" ]; then
        phrase=$(count_phrase ${#leftovers} 'file in it was' 'files in it were')
        printf '%s\n' "MQTT Bridge: keeping $dir: $phrase not deleted."
    fi
}

# The OpenWebif hook is one file in a directory full of other packages', so it
# is addressed by its exact path rather than swept: `MQTTBridge.pyc` beside
# where opkg's `MQTTBridge.py` was, and the `__pycache__` form of the same
# module. Nothing in `External/` is enumerated and the directory itself is never
# removed — an `External/` left holding an empty `__pycache__` is OpenWebif's
# business and not this package's.
remove_webif_hook() {
    external=$1

    case "$external" in
        */WebInterface/WebChilds/External) ;;
        *) return 0 ;;
    esac

    # 🔴 Every component from `WebInterface` down, not just the last one. A
    # symlink two levels up is followed exactly as silently as a symlink on the
    # directory itself — `[ -d ]` is true either way and `rm` would go straight
    # through it — so the whole tail is checked, and a link anywhere in it is
    # refused out loud for the same reason the plugin directory's is.
    for component in "${external%/WebChilds/External}" \
                     "${external%/External}" \
                     "$external"; do
        if [ -L "$component" ]; then
            printf '%s\n' "MQTT Bridge: $component is a symlink, so the compiled OpenWebif hook under it was left in place; delete it by hand if you want it gone."
            return 0
        fi
    done
    [ -d "$external" ] || return 0

    remove_compiled "$external/MQTTBridge.pyc"
    remove_compiled "$external/MQTTBridge.pyo"

    cache=$external/__pycache__
    if [ ! -L "$cache" ] && [ -d "$cache" ]; then
        # An unmatched glob stays literal in POSIX sh; a literal `*` is not a
        # file, and `remove_compiled` starts by asking whether it is one.
        for compiled in "$cache"/MQTTBridge.*.pyc "$cache"/MQTTBridge.*.pyo; do
            remove_compiled "$compiled"
        done
    fi
}

# Both halves are gated on the plugin directory's own name, so that the test
# seam above cannot be turned into a way of pointing either of them at somebody
# else's files. The hook's directory is derived from the configured path rather
# than from the resolved one: `…/Extensions/MQTTBridge` and
# `…/Extensions/WebInterface/WebChilds/External` are siblings, and a symlink on
# the plugin directory says nothing about where OpenWebif is installed.
case "$PLUGIN_DIR" in
    */MQTTBridge)
        sweep_plugin_directory "$PLUGIN_DIR" 2>/dev/null
        remove_webif_hook "${PLUGIN_DIR%/*}/WebInterface/WebChilds/External" 2>/dev/null
        ;;
esac

# Still true, and still the one thing removing the package cannot do for you.
echo "MQTT Bridge: retained topics are not retracted by uninstalling."
echo "Publish to enigma2/<node_id>/cmd/reset first if you want them gone."
exit 0
